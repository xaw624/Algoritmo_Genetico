# Variables del servicio streamlit@genetico
# Destino: /etc/streamlit/genetico.env (root:ubuntu, 640)
PYTHON_BIN=/home/ubuntu/Algoritmo_Genetico/.venv/bin/python
APP_FILE=/home/ubuntu/Algoritmo_Genetico/app.py
PORT=8516
# En producción no se muestran tracebacks a los visitantes
EXTRA_ARGS=--client.showErrorDetails=none
